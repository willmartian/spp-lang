{
  "$comment": "Highlights ```spp blocks in Markdown as Spec++, by injecting into VS Code's Markdown grammar.",
  "scopeName": "markdown.spp.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#sppBlock" }],
  "repository": {
    "sppBlock": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(spp)((?:[\\s,][^`]*)?)$",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.spp",
          "patterns": [{ "include": "source.spp" }]
        }
      ]
    }
  }
}
